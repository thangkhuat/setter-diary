{
	"name": "setter-diary",
	"version": "0.1.0",
	"description": "Setter Diary: a volleyball setter's training log (React PWA and Hono API on Cloudflare Workers)",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"preview": "npm run build && vite preview",
		"typecheck": "tsc -b",
		"lint": "eslint .",
		"test": "vitest run",
		"boundaries": "depcruise --config .dependency-cruiser.cjs src worker web",
		"boundaries:fixture": "node scripts/check-boundary-fixture.mjs",
		"journal:check": "node scripts/check-journal.mjs",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "wrangler d1 migrations apply DB --remote",
		"db:migrate:local": "wrangler d1 migrations apply DB --local",
		"db:seed:local": "wrangler d1 execute DB --local --file scripts/seed.sql",
		"smoke": "node scripts/smoke.mjs",
		"cf-typegen": "wrangler types",
		"deploy": "npm run build && wrangler deploy"
	},
	"dependencies": {
		"drizzle-orm": "0.45.3",
		"hono": "4.13.13",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"zod": "4.6.5"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "1.62.5",
		"@cloudflare/vitest-pool-workers": "0.22.0",
		"@eslint/js": "9.39.5",
		"@types/node": "24.19.1",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "6.1.2",
		"dependency-cruiser": "18.5.0",
		"drizzle-kit": "0.31.11",
		"eslint": "9.39.5",
		"eslint-plugin-react-hooks": "7.1.1",
		"eslint-plugin-react-refresh": "0.5.7",
		"globals": "17.13.0",
		"jsonc-parser": "3.3.1",
		"typescript": "6.0.3",
		"typescript-eslint": "8.71.1",
		"vite": "8.3.2",
		"vitest": "4.1.11",
		"wrangler": "4.147.0"
	}
}
